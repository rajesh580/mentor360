# Required API configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique random value of at least 32 characters for each environment
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Optional direct/unpooled database URL for migrations
DIRECT_DATABASE_URL=

# Initial institution administrator (used by `npm run db:bootstrap-admin`)
ADMIN_EMAIL=principal@svit.edu.in
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Dr. H.S. Ramesh (Principal)
ADMIN_INSTITUTION_CODE=SVIT-BLR
ADMIN_INSTITUTION_NAME=Sai Vidya Institute of Technology

# Create server/.env.admin from server/.env.admin.example for the one-time bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_INSTITUTION_CODE=
